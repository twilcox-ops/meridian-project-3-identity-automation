GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_KEY_VAULT_NAME=your-key-vault-name
GRAPH_CERT_NAME=your-cert-name

# Report email (mailer.py). Requires Mail.Send (application), scoped via
# Exchange Online RBAC for Applications to GRAPH_SENDER_MAILBOX only -- see
# mailer.py's docstring. If unset, the report is still built and logged,
# just not sent (same as Project 1's digest mailer).
GRAPH_SENDER_MAILBOX=
GRAPH_REPORT_RECIPIENT=
